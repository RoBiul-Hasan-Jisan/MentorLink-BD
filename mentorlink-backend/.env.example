PORT=4000
NODE_ENV=development
DEMO_MODE=true

# MongoDB Atlas or local. NEVER commit the real value.
MONGODB_URI=

FIREBASE_PROJECT_ID=mentorlink-67926
# Path to the Firebase service-account JSON (Firebase Console > Project settings > Service accounts)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json
# Optional: use the local Auth emulator instead of the real project
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Only for scripts/token.js (public web API key from your Firebase web config)
FIREBASE_WEB_API_KEY=

# Local testing only: lets seeds run while campus coordinates are still [0,0]
ALLOW_PLACEHOLDER_COORDS=true
CORS_ORIGINS=http://localhost:3000
