PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mentorlink
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=
DEMO_MODE=false
ALLOW_PLACEHOLDER_COORDS=false
REPORT_HIDE_THRESHOLD=3
# Set false only on databases without 2dsphere support (e.g. FerretDB)
MONGO_GEO_INDEX=true
# Tests wipe this database. Name must end with _test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/mentorlink_test
