PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mentorlink
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CORS_ORIGINS=
DEMO_MODE=false
ALLOW_PLACEHOLDER_COORDS=false
REPORT_HIDE_THRESHOLD=3
# Set false only on databases without 2dsphere support (e.g. FerretDB)
MONGO_GEO_INDEX=true
# Tests wipe this database. Name must end with _test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/mentorlink_test

# Set to false on all but one instance when you run several copies of the API (the reminder job is safe to run twice, this just saves load).
RUN_SCHEDULER=true

# Free scheduler hook. Set a long random string here AND as a secret in GitHub (see .github/workflows/keepalive-and-tick.yml).
# Leave empty to turn POST /internal/tick off.
CRON_SECRET=
